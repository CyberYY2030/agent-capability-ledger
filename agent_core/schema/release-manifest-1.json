{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "release-manifest/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "artifact_sha256", "files"],
  "properties": {
    "schema": {"const": "release-manifest/1"},
    "version": {"type": "string", "minLength": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"}
        }
      }
    }
  }
}
