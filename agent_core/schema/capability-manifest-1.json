{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability-manifest/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "capabilities"],
  "properties": {
    "schema": {"const": "capability-manifest/1"},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "source", "requirement", "runtimes", "trusted"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["rule", "skill", "hook", "ledger", "checker"]},
          "source": {"type": "string", "minLength": 1},
          "requirement": {"enum": ["required", "optional"]},
          "runtimes": {"type": "array", "minItems": 1, "items": {"enum": ["claude-code", "codex", "generic"]}},
          "trusted": {"type": "boolean"}
        }
      }
    }
  }
}
