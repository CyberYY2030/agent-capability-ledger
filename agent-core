#!/bin/sh

engine_root="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)" || exit 2
if [ -n "$AGENT_CORE_PYTHON" ]; then
  python_bin="$AGENT_CORE_PYTHON"
  launcher="single"
elif command -v python3 >/dev/null 2>&1; then
  python_bin="python3"
  launcher="single"
elif command -v python >/dev/null 2>&1; then
  python_bin="python"
  launcher="single"
elif command -v py >/dev/null 2>&1; then
  python_bin="py"
  launcher="py"
else
  echo "agent-core: Python 3 is unavailable" >&2
  exit 2
fi
export PYTHONPATH="$engine_root${PYTHONPATH:+:$PYTHONPATH}"
if [ "$launcher" = "py" ]; then
  exec "$python_bin" -3 -m agent_core.cli "$@"
fi
exec "$python_bin" -m agent_core.cli "$@"
